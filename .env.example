# --- Server ---
PORT=3000
# Link friends will open. Must be reachable from their phone (use a tunnel like ngrok/cloudflared for real friends).
PUBLIC_BASE_URL=http://localhost:3000

# --- LLM (the agent) ---
# anthropic | openrouter. Empty = whichever key below is set (Anthropic first).
LLM_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Free: create a key at openrouter.ai. "openrouter/free" routes to a free model that supports tools;
# or pin one, e.g. openai/gpt-oss-120b:free. Free models are rate limited (about 50 requests/day).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# --- iMessage via Photon Beta (app.beta.photon.codes) ---
# console = no real texts, an in-app outbox + inbound simulator instead (default). photon = real iMessage.
MESSENGER=console
# Project -> Settings -> Project ID (starts with pho_prj_)
PHOTON_PROJECT_ID=
# Project -> API keys -> New API key, with project:read, project:write, platforms:write
PHOTON_API_KEY=
# Shown to users/friends as the number to text (your shared line)
SHARED_LINE_NUMBER=+16289988199

# --- Product tunables ---
DURATION_DAYS=60
DEFAULT_TZ=America/New_York
# Virtual time: 1 = real time. 1440 = one real minute is one day. Dev panel can also skip days.
DEMO_TIME_SCALE=1
# Fill missing mock integration data (screen time, steps, calendar) with plausible seeded values
MOCK_AUTOFILL=1
DB_PATH=./data/letsgrow.db
# Web researcher helper (Claude's built-in web search, Anthropic only, $10 per 1,000 searches): max searches per question, 0 = off
WEB_SEARCH_MAX_USES=3

# --- Real data connectors (see docs/connectors.md) ---
# Google Calendar + Gmail: OAuth client of type "Web application"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the client's authorized redirect URI. Default: http://localhost:$PORT/oauth/google/callback
GOOGLE_REDIRECT_URI=
# iCloud link of the shared "Let'sGrow Health" Shortcut (shown as an Add button on the Health page)
HEALTH_SHORTCUT_URL=
# How often connected calendars and Gmail checks refresh
SYNC_MINUTES=10
