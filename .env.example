# Photon project credentials — dashboard → project → Settings.
# Copy this file to .env and fill in the real values. Never commit .env.
PROJECT_ID=pho_prj_xxxxxxxxxxxxxxxxxxxxxxxxxx
PROJECT_SECRET=

# OpenRouter key for the conversation half — https://openrouter.ai/keys
# Without it the agent still answers commands and still sends heartbeats; it
# just cannot hold a conversation.
OPENROUTER_API_KEY=

# Models in priority order. Keep BOTH ending in ':free' — OpenRouter bills
# whichever model answers, so a paid fallback is charged the moment the free
# one is rate-limited. `npm run models` re-checks these against the live
# catalogue, because free models get retired without notice.
# OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# OPENROUTER_FALLBACK_MODEL=google/gemma-4-31b-it:free
# LLM_TIMEOUT_MS=20000
# LLM_MAX_TOKENS=400

# Serve only this line. A project can hold several shared lines, and the same
# person texting from a different handle arrives on a different line as a
# separate chat. Leave unset to serve all of them.
AGENT_LINE=+1XXXXXXXXXX

# Minutes between proactive heartbeat texts, per chat.
HEARTBEAT_MINUTES=60

# Optional. Overrides the heartbeat wording; {n}, {time} and {next} interpolate.
# HEARTBEAT_MESSAGE=

# Seconds between inbound polls, and between checks for a due heartbeat.
POLL_SECONDS=3
HEARTBEAT_TICK_SECONDS=20
