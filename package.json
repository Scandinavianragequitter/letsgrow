{
  "name": "lets-grow",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Let'sGrow: an agent that verifies your habit and has a friend's agent nudge you over iMessage",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "tsx --env-file=.env src/main.ts",
    "dev": "tsx watch --env-file=.env src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "simulate": "tsx scripts/simulate.ts",
    "demo": "node scripts/demo.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@hono/node-server": "^1.13.0",
    "@photon-ai/api": "latest",
    "hono": "^4.13.0",
    "ical.js": "^2.2.1",
    "qrcode": "^1.5.4",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
